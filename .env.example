# Environment Configuration
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=election_admin
POSTGRES_PASSWORD=change_this_secure_password_123
POSTGRES_DB=election_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://election_admin:change_this_secure_password_123@db:5432/election_db
DATABASE_URL_SYNC=postgresql://election_admin:change_this_secure_password_123@db:5432/election_db

# Security
SECRET_KEY=generate-a-random-64-char-string-here-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Application
APP_NAME=College Election System
APP_VERSION=1.0.0
DEBUG=false
